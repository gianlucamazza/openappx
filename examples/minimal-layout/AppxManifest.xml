<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="OpenAppx.Example"
    Publisher="CN=OpenAppx-Example"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>openappx example</DisplayName>
    <PublisherDisplayName>openappx</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <!-- Windows.FullTrustApplication is rejected without this: a device answers
       0x80080204 "requires runFullTrust capability", pointing at the
       <Application> line. See docs/signing.md. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="app" Executable="app.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="openappx example"
        Description="Minimal layout for openappx pack tests"
        BackgroundColor="#1A1A1A"
        Square150x150Logo="Assets\StoreLogo.png"
        Square44x44Logo="Assets\StoreLogo.png">
        <uap:SplashScreen Image="Assets\StoreLogo.png" BackgroundColor="#1A1A1A" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
